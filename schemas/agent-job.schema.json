{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/optimizedwf/nine/schemas/agent-job.schema.json",
  "title": "AgentJob",
  "description": "Durable job record in the nine job ledger. A job is one execution of a workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "workflow_id",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "chain_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "If part of a chain, the chain id"
    },
    "status": {
      "enum": [
        "submitted",
        "routing",
        "running",
        "awaiting_evidence",
        "shipped",
        "fixing",
        "blocked",
        "cancelled",
        "recovered",
        "archived",
        "failed"
      ]
    },
    "input": {
      "type": [
        "object",
        "null"
      ],
      "description": "Task input as submitted (the redacted copy travels in route_decision.task_redacted)"
    },
    "route_decision": {
      "anyOf": [
        {
          "$ref": "route-decision.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "The ROUTE decision that selected this workflow, if attached"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "artifact-manifest.schema.json"
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "$ref": "evidence-verdict.schema.json"
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "Execution attempts (fix loops); a fresh job starts at 0"
    },
    "max_fix_loops": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
